# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Google Maps (server-side distance/geocoding calls)
GOOGLE_MAPS_SERVER_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# App URL (used for redirects and links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — sends a confirmation to the customer and a notification
# to support staff whenever a booking is made.
RESEND_API_KEY=
EMAIL_FROM="One Airport Taxi <booking@oneairporttaxi.com>"
SUPPORT_EMAIL=info@oneairporttaxi.com
