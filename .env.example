# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Google Maps
# Browser key: Maps JavaScript API + Places API (New), restricted by website referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: Routes API, restricted by server IP or left unrestricted during local development.
GOOGLE_MAPS_SERVER_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# App URL (used for redirects and links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Help button (bottom-right, on every page) — WhatsApp and Call can be
# different numbers/lines.
# Digits only, with country code, no "+" or spaces (e.g. 447123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# E.164 format (e.g. +447123456789) 
NEXT_PUBLIC_CALL_NUMBER=

# Email (Resend) — sends a confirmation to the customer and a notification
# to support staff whenever a booking is made.
RESEND_API_KEY=
EMAIL_FROM="One Airport Taxi <booking@oneairporttaxi.com>"
SUPPORT_EMAIL=info@oneairporttaxi.com

# Company details shown on invoices sent from the admin panel. All optional —
# COMPANY_PHONE/COMPANY_EMAIL fall back to the numbers above and CONTACT_EMAIL.
COMPANY_NAME="ONE Airport Taxi"
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_REGISTRATION_NUMBER=

# Structured address for the LocalBusiness JSON-LD schema (components/local-business-schema.tsx).
COMPANY_STREET_ADDRESS=
COMPANY_CITY=
COMPANY_POSTCODE=
COMPANY_COUNTRY=GB
